"""
test_biopsy_plan.py — ground-truth tests for the biopsy plan.

Simplest general set-up (as the assignment hints): the tumour is a unit
sphere at the origin, C = (0, 0, 0), R = 1. The needle starts at
P = (x0, 0, -10) and points straight up, v = (0, 0, 1). Then:
  * the closest approach to the centre is at s_c = 10
  * the targeting error is simply d = |x0|
  * if d < 1, the half-chord is h = sqrt(1 - d^2), core = 2h, depth = 10 + h
All expected values below were worked out by hand from these formulas.

Run:  python test_biopsy_plan.py
"""

import numpy as np
from biopsy_plan import plan_biopsy

TOL = 1e-9
C_UNIT, R_UNIT = np.array([0.0, 0.0, 0.0]), 1.0
UP = np.array([0.0, 0.0, 1.0])


def check(name, c, r, p, v, expected):
    out = plan_biopsy(c, r, p, v)
    ok = out["status"] == expected["status"]
    for key in ("targeting_error", "core_length"):
        ok &= abs(out[key] - expected[key]) < TOL
    if expected["insertion_depth"] is None:
        ok &= out["insertion_depth"] is None
    else:
        ok &= out["insertion_depth"] is not None and \
              abs(out["insertion_depth"] - expected["insertion_depth"]) < TOL

    fmt = lambda x: "None" if x is None else f"{x:.6g}"
    print(f"\n=== {name} ===")
    print(f"  {'':18}{'expected':>12}{'computed':>12}")
    print(f"  {'status':18}{expected['status']:>12}{out['status']:>12}")
    for key in ("targeting_error", "core_length", "insertion_depth"):
        print(f"  {key:18}{fmt(expected[key]):>12}{fmt(out[key]):>12}")
    print("  PASS" if ok else "  FAIL")
    return ok


# --------------------------------------------------------------------------
# Test 1: INTERSECTS, through the centre.  x0 = 0
#   d = 0, h = sqrt(1 - 0) = 1
#   enters at s = 10 - 1 = 9, exits at s = 10 + 1 = 11
#   core = 2, depth = 11
# --------------------------------------------------------------------------
def test_intersect_centre():
    return check("Test 1: intersects through centre (x0 = 0)",
                 C_UNIT, R_UNIT, [0, 0, -10], UP,
                 {"status": "intersects", "targeting_error": 0.0,
                  "core_length": 2.0, "insertion_depth": 11.0})


# --------------------------------------------------------------------------
# Test 2: INTERSECTS, off centre.  x0 = 0.6
#   d = 0.6, h = sqrt(1 - 0.36) = 0.8   (a 0.6-0.8-1 right triangle)
#   core = 1.6, depth = 10 + 0.8 = 10.8
# --------------------------------------------------------------------------
def test_intersect_off_centre():
    return check("Test 2: intersects off centre (x0 = 0.6)",
                 C_UNIT, R_UNIT, [0.6, 0, -10], UP,
                 {"status": "intersects", "targeting_error": 0.6,
                  "core_length": 1.6, "insertion_depth": 10.8})


# --------------------------------------------------------------------------
# Test 3: TOUCHES (tangent).  x0 = 1
#   d = 1 = R, h = 0: one contact point at (1, 0, 0), s = 10
#   core = 0, depth to the contact point = 10
# --------------------------------------------------------------------------
def test_tangent():
    return check("Test 3: touches / tangent (x0 = 1)",
                 C_UNIT, R_UNIT, [1, 0, -10], UP,
                 {"status": "touches", "targeting_error": 1.0,
                  "core_length": 0.0, "insertion_depth": 10.0})


# --------------------------------------------------------------------------
# Test 4: MISSES.  x0 = 2
#   d = 2 > R: no intersection. core = 0, no insertion depth.
# --------------------------------------------------------------------------
def test_miss():
    return check("Test 4: misses (x0 = 2)",
                 C_UNIT, R_UNIT, [2, 0, -10], UP,
                 {"status": "misses", "targeting_error": 2.0,
                  "core_length": 0.0, "insertion_depth": None})


# --------------------------------------------------------------------------
# Extra: tilted needle and a realistic tumour, not axis-aligned.
#   C = (10, 20, 30), R = 5 mm, v = (0, 0.6, 0.8)   (unit: 0.36 + 0.64 = 1)
#   P = C - 10 v + (3, 0, 0) = (13, 14, 22)
#   w = C - P = (-3, 6, 8)
#   s_c = w . v = 3.6 + 6.4 = 10
#   d^2 = |w|^2 - s_c^2 = 109 - 100 = 9  ->  d = 3
#   h = sqrt(25 - 9) = 4  ->  core = 8, depth = 10 + 4 = 14
# --------------------------------------------------------------------------
def test_tilted():
    return check("Extra: tilted needle, C = (10, 20, 30), R = 5",
                 [10, 20, 30], 5.0, [13, 14, 22], [0, 0.6, 0.8],
                 {"status": "intersects", "targeting_error": 3.0,
                  "core_length": 8.0, "insertion_depth": 14.0})


# --------------------------------------------------------------------------
# Extra edge cases
#   Tumour behind the needle: P = (0, 0, 10), pointing up, away from the
#   tumour. The line passes through the centre (d = 0) but going forward
#   never reaches it, so it is a miss.
#   Tip inside the tumour: P = (0, 0, 0), the centre. The core starts at the
#   tip (s = 0) and ends at s = 1: core = 1, depth = 1.
# --------------------------------------------------------------------------
def test_behind():
    return check("Extra: tumour behind the needle",
                 C_UNIT, R_UNIT, [0, 0, 10], UP,
                 {"status": "misses", "targeting_error": 0.0,
                  "core_length": 0.0, "insertion_depth": None})


def test_tip_inside():
    return check("Extra: tip already inside the tumour",
                 C_UNIT, R_UNIT, [0, 0, 0], UP,
                 {"status": "intersects", "targeting_error": 0.0,
                  "core_length": 1.0, "insertion_depth": 1.0})


if __name__ == "__main__":
    results = [test_intersect_centre(), test_intersect_off_centre(),
               test_tangent(), test_miss(),
               test_tilted(), test_behind(), test_tip_inside()]
    print(f"\n{sum(results)}/{len(results)} tests passed")
